<?xml version="1.0" encoding="utf-8"?>
<!-- The About screen: the app's own toolbar (Android 15 draws every app edge
     to edge, and the insets are handed out explicitly in AboutActivity), the
     version, and the developer badge, whose full-screen flash is the overlay
     at the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bip_bg"
            android:title="@string/about_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/bip_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/bip_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:text="@string/tagline"
                    android:textAllCaps="true"
                    android:textColor="@color/bip_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/bip_muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/about_offline"
                    android:textColor="@color/bip_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_safety"
                    android:textColor="@color/bip_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_keyboard"
                    android:textColor="@color/bip_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/source"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/about_source" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_license"
                    android:textColor="@color/bip_muted"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <!-- 36dp badge in a 44dp target: below 36 the badge's
                     wordmark collapses into an anonymous dark dot. -->
                <FrameLayout
                    android:id="@+id/dev_badge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/dev_badge"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/dev_badge_image"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:alpha="0.8"
                        android:background="@drawable/badge_circle"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dev_badge" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- The badge thrown up full screen for three seconds (DevFlash). Two
         layers on purpose: the veil fades, the lockup inside it scales, and
         scaling the veil would pull its edges in from the screen's. -->
    <FrameLayout
        android:id="@+id/flash"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bip_veil"
        android:clickable="true"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/flash_lockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/flash_logo"
                android:layout_width="256dp"
                android:layout_height="256dp"
                android:background="@drawable/badge_circle"
                android:contentDescription="@string/dev_badge_full"
                android:elevation="12dp"
                android:src="@drawable/dev_badge_full" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/dev_handle"
                android:textColor="@color/bip_muted"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
